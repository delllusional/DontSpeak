# Shell scripts and Linux desktop/audio-config assets are executed on Linux, where a
# CRLF (from Windows autocrlf) breaks the shebang / parsing. Pin them to LF everywhere.
*.sh                     text eol=lf
*.desktop                text eol=lf
apps/linux/aec/*.conf    text eol=lf
apps/linux/aec/*.pa      text eol=lf
apps/linux/udev-rule.txt text eol=lf

# Workflow scripts (.claude/workflows) are read verbatim by the Workflow tool's
# permission dialog, which rejects embedded \r as a hidden control character. Pin
# them to LF so a Windows checkout with autocrlf=true doesn't break `Workflow({name: ...})`.
.claude/workflows/*.js   text eol=lf
