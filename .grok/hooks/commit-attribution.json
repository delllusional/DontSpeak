{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|run_terminal_command|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/agents/capture-agent-attribution.mjs", "grok"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
