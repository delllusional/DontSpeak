{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/agents/capture-agent-attribution.mjs\" codex",
            "commandWindows": "$root = git rev-parse --show-toplevel; node \"$root/scripts/agents/capture-agent-attribution.mjs\" codex",
            "timeout": 30,
            "statusMessage": "Capturing exact commit attribution"
          }
        ]
      }
    ]
  }
}
